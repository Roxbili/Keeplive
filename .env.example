# Copy to .env when changing defaults. Node.js 24 loads it at startup.
HOST=127.0.0.1
PORT=3210
# DATA_DIR=E:/Keeplive-data
SCAN_INTERVAL_SECONDS=60

# Enable these together when using an HTTPS domain gateway.
# PUBLIC_ORIGIN=https://photos.example.com
# COOKIE_SECURE=1

# Only trust the exact private proxy address if you need client-IP forwarding.
# TRUST_PROXY=100.100.100.100
# FFMPEG_PATH=C:/tools/ffmpeg.exe
