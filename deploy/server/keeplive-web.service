[Unit]
Description=Keeplive HTTPS frontend and home album gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
DynamicUser=yes
SupplementaryGroups=keeplive-tls
StateDirectory=keeplive-web
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/keeplive-web/data
Environment=XDG_CONFIG_HOME=/var/lib/keeplive-web/config
ExecStart=/usr/local/bin/keeplive-caddy run --config /etc/keeplive/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/keeplive-web
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
