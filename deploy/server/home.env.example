# Merge with the home's existing .env only after confirming the public hostname.
# Keep any existing photo/data, FFmpeg and scan configuration.
HOST=127.0.0.1
PORT=3210
PUBLIC_ORIGIN=https://photos.example.com
COOKIE_SECURE=1
# Reverse SSH connects to the home backend from this exact loopback address.
# Caddy supplies the real client address and removes untrusted incoming XFF values.
TRUST_PROXY=127.0.0.1
